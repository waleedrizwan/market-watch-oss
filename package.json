{
  "name": "market-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Upstream vs. store prices with a lag-model forecast, served from a Cloudflare Worker behind Cloudflare Access.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:py": "python -m pytest -q",
    "test:all": "npm run typecheck && npm test && npm run test:py && npm run test:e2e",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
